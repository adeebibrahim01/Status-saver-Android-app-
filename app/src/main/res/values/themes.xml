<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WhatsDownloadPlus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/whatsapp_green</item>
        <item name="colorPrimaryVariant">@color/whatsapp_dark_green</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#004D40</item>
        <item name="android:navigationBarColor">#004D40</item>

        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item> <item name="windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="windowSplashScreenBackground" tools:targetApi="s">@android:color/white</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowFrame">@null</item>
    </style>

    <style name="Theme.App.InternalSplash" parent="Theme.WhatsDownloadPlus.NoActionBar">
        <item name="windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="windowSplashScreenBackground" tools:targetApi="s">@android:color/white</item>
        <item name="windowSplashScreenAnimationDuration" tools:targetApi="s">0</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.RoundedBottomSheet</item>
    </style>

    <style name="ShapeAppearance.RoundedBottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="Theme.WhatsDownloadPlus.NoActionBar" parent="Theme.WhatsDownloadPlus">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="CircleCard" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Circle</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="Theme.WhatsDownloadPlus.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.WhatsDownloadPlus.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ShapeAppearance.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ToolItemStyle">
        <item name="android:layout_width">68dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#80FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
</resources>