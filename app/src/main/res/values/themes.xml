<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- WhatsApp-style Light Theme -->
    <style name="Theme.WhatsDownloadPlus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary WhatsApp colors -->
        <item name="colorPrimary">@color/whatsapp_green</item>
        <item name="colorPrimaryVariant">@color/whatsapp_dark_green</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary accent (like WhatsApp teal) -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:navigationBarColor">@color/whatsapp_green</item>
        <item name="android:statusBarColor">@color/whatsapp_dark_green</item>

        <!-- Default text and icon tint -->
        <item name="android:textColor">@android:color/black</item>
        <item name="android:colorBackground">@color/white</item>
    </style>

    <!-- NoActionBar variant -->
    <style name="Theme.WhatsDownloadPlus.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Toolbar and Popup Styles -->
    <style name="Theme.WhatsDownloadPlus.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.WhatsDownloadPlus.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
