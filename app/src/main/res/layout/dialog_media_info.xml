<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded"
    android:elevation="8dp"
    android:gravity="start">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Media Details"
        android:textSize="20sp"
        android:textColor="#222222"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMediaType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Type: Image"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name: example.jpg"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"
        android:ellipsize="middle"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/tvFileSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Size: 1024 KB"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resolution: 1080 x 1920"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duration: 0h 0m 0s"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/whatsapp_green"
        app:cornerRadius="12dp"
        android:layout_marginTop="8dp"
        android:insetBottom="0dp"
        android:insetTop="0dp"/>

</LinearLayout>