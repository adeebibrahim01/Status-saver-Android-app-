<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECE5DD">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@drawable/white_luxury_header_bg"
        android:elevation="4dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <FrameLayout
            android:id="@+id/profileContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toEndOf="@id/btnBack"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgToolbarProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/round_image"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />
            <TextView
                android:id="@+id/txtAlphabet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_circle_placeholder"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/profileContainer"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="User Profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="16dp"
        android:background="@drawable/whatsapp_top_transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_message" app:tint="#FFB300" />
                <TextView android:id="@+id/tvTotalMessages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="14sp" android:textColor="#121212" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/messages" android:textSize="10sp" android:textColor="#9E9E9E" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="30dp" android:background="#E0E0E0" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_timer" app:tint="#FFB300" />
                <TextView android:id="@+id/tvAvgReplyTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textStyle="bold" android:textSize="14sp" android:textColor="#121212" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/avg_reply" android:textSize="10sp" android:textColor="#9E9E9E" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="30dp" android:background="#E0E0E0" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_gallery" app:tint="#FFB300" />
                <TextView android:id="@+id/tvMediaCaptured" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="14sp" android:textColor="#121212" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/New_media" android:textSize="10sp" android:textColor="#9E9E9E" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_behavioral_analysis"
            android:textSize="10sp"
            android:layout_marginTop="20dp"
            android:textColor="#FFB300"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvPersonalityType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/type_analyzing" android:background="#FFF3E0" android:padding="6dp" android:layout_marginEnd="8dp" android:textSize="11sp" android:textColor="#E65100"/>
                <TextView android:id="@+id/tvCommunicationStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vibe_analyzing" android:background="#E8F5E9" android:padding="6dp" android:textSize="11sp" android:textColor="#1B5E20"/>
            </LinearLayout>
        </HorizontalScrollView>



        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="16dp">
            <TextView android:id="@+id/tvMood" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/mood_analyzing" android:textSize="11sp" android:layout_columnWeight="1" android:textStyle="bold" android:textColor="#333"/>
            <TextView android:id="@+id/tvDensity" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/typenew_analyzing" android:textSize="11sp" android:layout_columnWeight="1" android:textStyle="bold" android:textColor="#333"/>
            <TextView android:id="@+id/tvPeakHours" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/peak_analyzing" android:textSize="10sp" android:layout_columnWeight="1" android:layout_marginTop="6dp" android:textColor="#666"/>
            <TextView android:id="@+id/tvFavWord" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/fav_analyzing" android:textSize="10sp" android:layout_columnWeight="1" android:layout_marginTop="6dp" android:textColor="#666"/>
        </GridLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetailMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

</LinearLayout>