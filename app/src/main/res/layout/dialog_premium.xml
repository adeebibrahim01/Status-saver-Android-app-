<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/premium_dialog_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✧ GO PREMIUM ✧"
        android:textColor="@color/premium_gold"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove all ads and unlock AI features"
        android:textColor="#FFFFFF"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnMonthly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start 3-Day Free Trial\n(Then $1.49/Month)"
        android:backgroundTint="@color/premium_gold"
        android:layout_marginTop="20dp"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnLifetime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lifetime Access - $6.99\n(One-time Payment)"
        android:backgroundTint="#33FFFFFF"
        android:layout_marginTop="12dp"
        android:padding="12dp"/>

</LinearLayout>