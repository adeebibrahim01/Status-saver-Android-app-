<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004D40">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="#082B26"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D4AF37">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="35dp"
                android:paddingHorizontal="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:padding="3dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:background="@drawable/gold_glow_ring"
                    app:shapeAppearanceOverlay="@style/CircleAppearance"
                    android:elevation="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Status Saver"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dots_capsule"
                    android:backgroundTint="#D4AF37"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="PREMIUM ACCESS"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            app:cardBackgroundColor="#0A1F1C"
            app:cardCornerRadius="30dp"
            app:cardElevation="15dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D4AF37">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="26dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dots_capsule"
                        android:backgroundTint="#D4AF37"
                        android:fontFamily="sans-serif-black"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="EARLY BIRD SPECIAL: STEP 1"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:letterSpacing="0.1" />

                    <CheckBox
                        android:id="@+id/selectWhatsappcheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#D4AF37"
                        android:scaleX="1.3"
                        android:scaleY="1.3" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Smart AI Media Engine"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:letterSpacing="0.02" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Advanced scanning for better media quality."
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:alpha="0.9" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Faster downloads with every new update."
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:alpha="0.9" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• JOIN NOW for exclusive future rewards."
                        android:textColor="#D4AF37"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:text="[ START SETUP ]"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:letterSpacing="0.1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0.6"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Note: Please keep the app installed to maintain your premium rewards and future updates."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingHorizontal="15dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>