<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004D40">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingBottom="40dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconContainer"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="60dp"
                app:cardBackgroundColor="#082B26"
                app:cardCornerRadius="55dp"
                app:cardElevation="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#D4AF37"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="28dp"
                    android:src="@drawable/ic_folder_security"
                    app:tint="#D4AF37" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/storage_permission"
                android:textColor="#D4AF37"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                app:layout_constraintTop_toBottomOf="@id/iconContainer" />

            <TextView
                android:id="@+id/subTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/to_show_your_latest_statuses_we_need_access_to_your_status_folder"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/titleText" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mainActionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#082B26"
                app:cardCornerRadius="35dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#33D4AF37"
                app:layout_constraintTop_toBottomOf="@id/subTitleText">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dots_capsule"
                        android:backgroundTint="#D4AF37"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.2"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="5dp"
                        android:text="@string/step_2"
                        android:textColor="#000000"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/permissionTitleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/select_folder"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:letterSpacing="0.04"
                        android:textAllCaps="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.6"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/please_select_the_statuses_folder_to_automatically_sync_your_media"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/allowStatusFolderButton"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="30dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/allow_access"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:letterSpacing="0.05"
                        app:backgroundTint="#D4AF37"
                        app:cornerRadius="22dp"
                        app:elevation="12dp"
                        app:rippleColor="#4DFFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusfolder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/need_help_view_guide"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                app:icon="@drawable/ic_premium_greater_than"
                app:iconGravity="textEnd"
                app:iconSize="14dp"
                app:iconTint="#D4AF37"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mainActionCard" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>