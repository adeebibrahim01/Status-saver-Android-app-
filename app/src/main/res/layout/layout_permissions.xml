<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ECE5DD"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- 1. WhatsApp Status Folder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/whatsapp_card_bg"
                android:layout_marginBottom="12dp"
                android:clipToOutline="true"
                android:elevation="0dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:background="@drawable/circle_teal"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/permissionTitleStatus"
                        android:text="Status Folder Access"
                        android:textStyle="bold"
                        android:textColor="#2FB19C"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:lineSpacingExtra="2dp"/>

                </LinearLayout>


                <Button
                    android:id="@+id/allowStatusFolderButton"
                    android:text="Allow"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/permission_button_bg"
                    android:layout_width="90dp"
                    android:layout_height="50dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- 3. Guide Status Folder Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/statusfolder"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#C8E6C9"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="How to Set WhatsApp Status Folder path"
                    android:textAllCaps="false"
                    android:textColor="#ffffff" />

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="*If you are having any difficulty, contact us at mariaadeeb982@gmail.com"
                android:textSize="12sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
