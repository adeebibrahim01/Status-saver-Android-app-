<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ECE5DD"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. Storage Access -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/permission_card_bg"
                android:layout_marginBottom="12dp"
                android:clipToOutline="true"
                android:elevation="3dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:background="@drawable/circle_teal"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/permissionTitleStorage"
                        android:text="Storage Access"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/permissionDescriptionStorage"
                        android:text="Allow storage access so that when a status is downloaded, it can be saved directly to your device."
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/allowStorageButton"
                    android:text="Allow"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/permission_button_bg"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- 2. WhatsApp Status Folder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/permission_card_bg"
                android:layout_marginBottom="12dp"
                android:clipToOutline="true"
                android:elevation="3dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:background="@drawable/circle_teal"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/permissionTitleStatus"
                        android:text="WhatsApp Status Folder"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/permissionDescriptionStatus"
                        android:text="Allow .status folder permission so the app can access and show your status images and videos."
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/allowStatusFolderButton"
                    android:text="Allow"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/permission_button_bg"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="*If you are having any difficulty, contact us at mariaadeeb982@gmail.com"
                android:textSize="12sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
