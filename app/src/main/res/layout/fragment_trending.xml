<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ultra_luxury_bg">

    <!-- Premium Luxury Header Section -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/white_luxury_header_bg"
            android:elevation="8dp"
            android:clipChildren="false">

            <!-- Left Decorative Watermark -->
            <FrameLayout
                android:id="@+id/watermarkContainerLeft"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="-30dp"
                android:layout_marginTop="-10dp"
                android:alpha="0.15"
                android:rotation="25"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_premium_glass_chip"
                    android:alpha="0.3" />

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:rotation="-15"
                    android:src="@drawable/ic_video_library_dashboard"
                    app:tint="#D4AF37" />
            </FrameLayout>

            <!-- Center Titles -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="✧ AI TRENDING ✧"
                    android:textAllCaps="true"
                    android:textColor="#BC9112"
                    android:textSize="11sp"
                    android:letterSpacing="0.4" />

                <TextView
                    android:id="@+id/toolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dancing_script"
                    android:text="Viral Status"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right Decorative Watermark -->
            <FrameLayout
                android:id="@+id/watermarkContainerRight"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="-30dp"
                android:layout_marginTop="-10dp"
                android:alpha="0.15"
                android:rotation="-25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_premium_glass_chip"
                    android:alpha="0.3" />

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:rotation="15"
                    android:src="@drawable/ic_photo_library_dashboard"
                    app:tint="#D4AF37" />
            </FrameLayout>

            <!-- Bottom Gold Line Decoration -->
            <View
                android:layout_width="50dp"
                android:layout_height="3dp"
                android:background="@drawable/gold_line_gradient"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="12dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main List (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrending"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="60dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LOADER: Main Screen Center -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:indeterminateTint="#D4AF37"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>