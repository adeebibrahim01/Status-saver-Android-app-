<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#121212"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#D4AF37" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.4"
            android:text="✧ MAGIC LAB PRO ✧"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnResetManual"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#D4AF37" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/gold_center_gradient"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/imgPreviewMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerInside" />

        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/gold_line_gradient"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loaderContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/customProgressBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminateTint="#D4AF37" />

            <TextView
                android:id="@+id/tvPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.3"
                android:text="AI ENHANCING..."
                android:textColor="#D4AF37"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:gravity="center"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbDenoise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#D4AF37"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="DENOISE"
                android:textColor="#D4AF37"
                android:textSize="9sp" />

            <View
                android:layout_width="50dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="25dp"
                android:background="#33D4AF37" />

            <CheckBox
                android:id="@+id/cbHDR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#D4AF37"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="VIVID HDR"
                android:textColor="#D4AF37"
                android:textSize="9sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <include android:id="@+id/toolExposure_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolHighlights_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolShadows_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolContrast_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolBrightness_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolVibrance_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolWarmth_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolSaturation_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolTint_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolClarity_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolDetail_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolVignette_hidden" layout="@layout/layout_tuning_item" />
            <include android:id="@+id/toolSmooth_hidden" layout="@layout/layout_tuning_item" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/seekbarContainer"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <TextView
                android:id="@+id/activeToolName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.4"
                android:text="EXPOSURE"
                android:textColor="#D4AF37"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/mainSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/gold_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/gold_seekbar_thumb" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:background="#0F0F0F"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout android:id="@+id/toolSmooth" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_smooth" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Smooth" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolExposure" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_exposure" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Exposure" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolHighlights" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_highlights" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Highlights" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolShadows" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_shadows" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Shadows" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolContrast" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_contrast" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Contrast" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolBrightness" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_brightness" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Bright" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolVibrance" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_vibrance" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Vibrance" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolWarmth" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_warmth" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Warmth" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolSaturation" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_color" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Color" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolTint" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_tint" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Tint" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolClarity" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_clarity" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Clarity" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolDetail" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_details" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Sharpen" android:textColor="#B3FFFFFF" />
                </LinearLayout>

                <LinearLayout android:id="@+id/toolVignette" style="@style/ToolItemStyle">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_vignette" app:tint="#D4AF37" />
                    <TextView style="@style/ToolTextStyle" android:text="Vignette" android:textColor="#B3FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#121212"
            android:paddingHorizontal="20dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupQuality"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewOriginal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:text="ORIGINAL"
                    android:textColor="#80FFFFFF"
                    android:textSize="9sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHD"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-bold"
                    android:text="MAGIC HD"
                    android:textColor="#D4AF37"
                    android:textSize="9sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#D4AF37" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadSelected"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:backgroundTint="#D4AF37"
                android:elevation="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.2"
                android:text="EXPORT"
                android:textColor="#000000"
                android:textSize="12sp"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_save"
                app:iconTint="#000000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>