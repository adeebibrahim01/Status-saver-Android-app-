<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_white_glow"
        android:alpha="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"/>

    <ScrollView
        android:id="@+id/privacyScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/white">
                        <ImageView
                            android:id="@+id/imgPrivacyLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@mipmap/ic_launcher"
                            android:contentDescription="@string/app_name"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPrivacyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_title"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvPrivacyLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/privacy_last_updated"
                        android:textColor="#B3FFFFFF"
                        android:letterSpacing="0.05"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/llPrivacyContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvHeadingSection1"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_1_heading"
                        android:textColor="#075E54"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:id="@+id/tvBodySection1"
                        style="@style/PrivacyBody"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_section_1"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#444444"/>

                    <View android:layout_width="40dp" android:layout_height="3dp"
                        android:background="#1A075E54" android:layout_marginVertical="20dp"/>

                    <TextView
                        android:id="@+id/tvHeadingSection2"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_2_heading"
                        android:textColor="#075E54"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:id="@+id/tvBodySection2"
                        style="@style/PrivacyBody"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_section_2"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#444444"/>

                    <LinearLayout
                        android:id="@+id/llDisclaimerBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_disclaimer_premium"
                        android:padding="16dp"
                        android:layout_marginVertical="24dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDisclaimerHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@android:drawable/ic_dialog_info"
                            android:drawablePadding="8dp"
                            android:drawableTint="#075E54"
                            android:text="@string/disclaimer_heading"
                            android:textColor="#075E54"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-black"
                            android:textAllCaps="true"/>

                        <TextView
                            android:id="@+id/tvDisclaimerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/disclaimer_text"
                            android:textColor="#555555"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeadingSection8"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_8_heading"
                        android:textColor="#075E54"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:id="@+id/tvBodySection8"
                        style="@style/PrivacyBody"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_section_8"
                        android:textColor="#444444"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>