<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title -->
            <TextView
                android:id="@+id/privacyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="8dp"/>

            <!-- Last Updated -->
            <TextView
                android:id="@+id/privacyLastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_last_updated"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="16dp"/>

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_1_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_1"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_2_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_2"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_3_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_3"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_4_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_4"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_5_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_5"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 6 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_6_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_6"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 7 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_7_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_7"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>

            <!-- Section 8 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_text"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="12dp"/>


            <!-- Section 8 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_8_heading"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#075E54"
                android:paddingBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_section_8"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
