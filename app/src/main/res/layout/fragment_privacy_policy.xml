<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE5DD">

    <ScrollView
        android:id="@+id/privacyScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imgPrivacyLogo"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@mipmap/ic_launcher"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="@string/app_name"/>

                    <TextView
                        android:id="@+id/tvPrivacyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_title"
                        android:textColor="#075E54"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPrivacyLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_last_updated"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/llPrivacyContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvHeadingSection1"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_1_heading" />

                    <TextView
                        android:id="@+id/tvBodySection1"
                        style="@style/PrivacyBody"
                        android:text="@string/privacy_section_1" />

                    <View
                        android:id="@+id/divider1"
                        style="@style/PrivacyDivider" />

                    <TextView
                        android:id="@+id/tvHeadingSection2"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_2_heading" />

                    <TextView
                        android:id="@+id/tvBodySection2"
                        style="@style/PrivacyBody"
                        android:text="@string/privacy_section_2" />

                    <View
                        android:id="@+id/divider2"
                        style="@style/PrivacyDivider" />

                    <LinearLayout
                        android:id="@+id/llDisclaimerBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF9C4"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDisclaimerHeading"
                            style="@style/PrivacyHeading"
                            android:textColor="#A57900"
                            android:text="@string/disclaimer_heading" />

                        <TextView
                            android:id="@+id/tvDisclaimerText"
                            style="@style/PrivacyBody"
                            android:text="@string/disclaimer_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeadingSection8"
                        style="@style/PrivacyHeading"
                        android:text="@string/privacy_section_8_heading" />

                    <TextView
                        android:id="@+id/tvBodySection8"
                        style="@style/PrivacyBody"
                        android:layout_marginBottom="0dp"
                        android:text="@string/privacy_section_8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>