<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/whatsapp_top_transparent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="32dp"
        android:paddingHorizontal="24dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ProgressBar
                android:id="@+id/statusProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#00796B"
                android:indeterminateTintMode="src_in"
                style="?android:attr/progressBarStyleSmall" />

            <ImageView
                android:id="@+id/ivStatusResultIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_wa_download"
                android:visibility="gone"
                app:tint="#00796B"
                android:background="@drawable/bg_circle_light_green" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatusInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.15"
            android:text="Processing..."
            android:textAllCaps="true"
            android:textColor="#2D2D2D"
            android:textSize="11sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.5"
            android:fontFamily="sans-serif-medium"
            android:text="Please wait a moment"
            android:textColor="#000000"
            android:textSize="9sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>