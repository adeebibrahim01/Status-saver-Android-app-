<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_all_saved_vault"
        android:contentDescription="Icon"
        app:tint="#075E54" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Download Quality"
        android:textColor="#212121"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Standard HD uses AI to enhance clarity and colors of your status."
        android:textColor="#757575"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#F1F8E9"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#388E3C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="For Pro AI Styles &amp; HD Editing, please go to Preview and click on the Edit icon."
            android:textColor="#388E3C"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDontShow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="start"
        android:text="Don't show this again"
        android:textColor="#757575"
        android:textSize="13sp"
        app:buttonTint="#075E54" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUltraHD"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Ultra HD ✨"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#075E54"
        app:cornerRadius="12dp"
        app:elevation="2dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStandard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Standard Quality"
        android:textAllCaps="false"
        android:textColor="#075E54"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>