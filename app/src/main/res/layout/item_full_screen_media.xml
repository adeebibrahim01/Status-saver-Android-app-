<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. PhotoView for Images -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/fullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 2. PlayerView for Videos -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/fullPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- 3. Play Icon Indicator (Optional but good for UX) -->
    <ImageView
        android:id="@+id/imgPlayIcon"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_play"
        android:alpha="0.6"
        android:visibility="gone"
        app:tint="#FFFFFF" />

    <!-- 🔥 4. Loading UI (Naya Add Kiya Hai) -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Premium Golden Progress Bar -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#D4AF37"
            app:trackColor="#33D4AF37"
            app:indicatorSize="40dp"
            app:trackThickness="4dp" />

        <!-- Percentage Text (Buffering ke liye) -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>