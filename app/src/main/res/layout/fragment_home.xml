<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE5DD"
    tools:context=".ui.Home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_luxury_header_bg"
        android:clipChildren="false"
        android:elevation="8dp"
        android:paddingBottom="70dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/watermarkContainerLeft"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginStart="-30dp"
            android:layout_marginTop="-10dp"
            android:alpha="0.15"
            android:rotation="25"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_premium_glass_chip"
                android:alpha="0.3" />

            <ImageView
                android:id="@+id/ivdashboardIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:rotation="-15"
                android:src="@drawable/ic_video_library_dashboard"
                app:tint="#D4AF37" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/watermarkContainerRight"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginEnd="-30dp"
            android:layout_marginTop="-10dp"
            android:alpha="0.15"
            android:rotation="-25"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_premium_glass_chip"
                android:alpha="0.3" />

            <ImageView
                android:id="@+id/ivImagesIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:padding="8dp"
                android:rotation="15"
                android:src="@drawable/ic_photo_library_dashboard"
                app:tint="#D4AF37" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/centerGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/headerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.4"
                android:text="✧ PREMIUM VAULT ✧"
                android:textAllCaps="true"
                android:textColor="#BC9112"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dancing_script"
                android:includeFontPadding="false"
                android:shadowColor="#40D4AF37"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="8"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/secureLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_privacy_pill_gold"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_lock_secure"
                    app:tint="#D4AF37" />

                <TextView
                    android:id="@+id/tvTestTrending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="@string/privacy_protected"
                android:textAllCaps="true"
                android:textColor="#D4AF37"
                android:textSize="9sp"
                android:clickable="true"
                android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/infoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_premium_glass_chip"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/centerGroup">

            <TextView
                android:id="@+id/joinedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:text="@string/since_2019"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ic_calender_new"
                app:drawableTint="#D4AF37"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/infoDivider"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#26D4AF37"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/projectVersion"
                app:layout_constraintStart_toEndOf="@id/joinedText"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/projectVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:text="@string/v1_0_16"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ic_info_outline"
                app:drawableTint="#D4AF37"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="80dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/gold_line_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="-55dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/waHeader">

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/whatsapp_card_transparent"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveStreak"
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeColor="#15D4AF37"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/label1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:textColor="#424242"
                        android:text="@string/available"
                        android:textSize="8sp"
                        />

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_gold_faint"
                            android:alpha="0.12" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="7dp"
                            android:background="@drawable/bg_circle_light_green"
                            android:src="@drawable/ic_all_status_combined"
                            app:tint="#424242" />
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">

                        <ProgressBar
                            android:id="@+id/pbActiveStreak"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:indeterminateTint="#424242"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tvActiveStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="45"
                            android:textColor="#212121"
                            android:textSize="22sp"
                            android:visibility="gone"
                            android:translationZ="2dp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_premium_pill_faint"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:text="@string/statuses"
                            android:textAllCaps="true"
                            android:textColor="#424242"
                            android:textSize="8sp" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="#D4AF37"
                            android:alpha="0.6" />

                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayDownloads"
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeColor="#15D4AF37"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/today_s"
                        android:textAllCaps="true"
                        android:textColor="#424242"
                        android:textSize="8sp"
                        android:letterSpacing="0.1" />

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_gold_faint"
                            android:alpha="0.12" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="7dp"
                            android:background="@drawable/bg_circle_light_green"
                            android:src="@drawable/ic_today_downloads"
                            app:tint="#424242" />
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">

                        <ProgressBar
                            android:id="@+id/pbTodayCount"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:indeterminateTint="#424242"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tvTodayCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="12"
                            android:textColor="#212121"
                            android:textSize="22sp"
                            android:visibility="gone"
                            android:translationZ="2dp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDownloadsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_premium_pill_faint"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:text="@string/downloads"
                            android:textAllCaps="true"
                            android:textColor="#424242"
                            android:textSize="8sp" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="#D4AF37"
                            android:alpha="0.6" />

                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLast7Days"
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="8dp"
                app:cardMaxElevation="12dp"
                app:strokeColor="#15D4AF37"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/saved"
                        android:textAllCaps="true"
                        android:textColor="#424242"
                        android:textSize="8sp"
                        android:letterSpacing="0.1" />

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_gold_faint"
                            android:alpha="0.12" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:background="@drawable/bg_circle_light_green"
                            android:src="@drawable/ic_all_saved_vault"
                            app:tint="#424242" />
                    </FrameLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true">

                        <ProgressBar
                            android:id="@+id/pbLast7Days"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:indeterminateTint="#424242"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tvLast7DaysCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="07"
                            android:textColor="#212121"
                            android:textSize="22sp"
                            android:visibility="gone"
                            android:translationZ="2dp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDaysLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_premium_pill_faint"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:text="@string/_7days"
                            android:textAllCaps="true"
                            android:textColor="#424242"
                            android:textSize="8sp" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="#D4AF37"
                            android:alpha="0.6" />

                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

            <!-- Main 6 Buttons Menu -->
            <include
                android:id="@+id/homeMenuLayout"
                layout="@layout/layout_home_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginHorizontal="18dp"
                app:layout_constraintTop_toBottomOf="@id/statsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <!-- Recent Downloads Section -->
            <include
                android:id="@+id/homeRecentLayout"
                layout="@layout/layout_home_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeMenuLayout" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>