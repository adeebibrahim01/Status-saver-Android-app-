<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_feedback_dialog"
    android:gravity="center"
    android:clipToPadding="false">



    <!-- Body / Feedback Prompt -->
    <TextView
        android:id="@+id/tvFeedbackTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enjoying the app?"
        android:textSize="20sp"
        android:textColor="#000"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFeedbackMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please leave a review on the Play Store. It helps us improve the app."
        android:textSize="16sp"
        android:textColor="#555"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Give Feedback Button -->
    <Button
        android:id="@+id/btnGiveFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Give Feedback"
        android:textAllCaps="false"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFF"
        android:elevation="4dp"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- Close (X) Button below Feedback -->
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_close_white"
        android:contentDescription="Close"
        android:background="@drawable/circle_red_bg"
        android:padding="8dp"
        android:elevation="4dp"/>

</LinearLayout>
