<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <!-- Keyword Input -->
    <EditText
        android:id="@+id/inputKeyword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter new keyword"
        android:padding="12dp"
        android:background="@drawable/bg_whatsapp_edittext"
        android:textColor="@android:color/black"
        android:textColorHint="#A0A0A0"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:imeOptions="actionDone"
        android:inputType="text"/>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnSaveKeyword"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Save"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_whatsapp_button"
            android:textStyle="bold"/>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Export"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_whatsapp_button_secondary"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheetRecyclerKeywords"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipToPadding="false"
        android:padding="4dp"
        android:scrollbars="vertical"/>
</LinearLayout>
