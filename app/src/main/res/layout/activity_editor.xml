<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:padding="16dp">
        <ImageView android:id="@+id/btn_cancel" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_close" />
        <ImageView android:id="@+id/btn_done" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:src="@drawable/ic_check" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/toolbar_editor">

        <ImageView
            android:id="@+id/img_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.mariaxcodexpert.whatsdownloadplus.ui.stickers.DrawingView
            android:id="@+id/drawing_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.mariaxcodexpert.whatsdownloadplus.ui.stickers.StickerTextView
            android:id="@+id/sticker_text_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/toolbar_editor"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_clip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Clip" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/btn_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Text" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/btn_cutout" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Cutout" android:gravity="center" android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>