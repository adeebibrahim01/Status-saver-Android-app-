<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/permission_card_bg"
    android:elevation="4dp"
    android:layout_marginVertical="8dp"
    android:clipToOutline="true">

    <!-- Permission Icon -->
    <ImageView
        android:id="@+id/permissionIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_permission"
        android:contentDescription="@string/permission_icon"
        android:scaleType="centerInside" />

    <!-- Texts -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <!-- Permission Title -->
        <TextView
            android:id="@+id/permissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage Permission"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#075E54"
            android:fontFamily="sans-serif-medium" />

        <!-- Permission Description -->
        <TextView
            android:id="@+id/permissionDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required to access photos and videos."
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"/>
    </LinearLayout>

    <!-- Allow Button -->
    <Button
        android:id="@+id/permissionButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Allow"
        android:textAllCaps="false"
        android:background="@drawable/permission_button_bg"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:fontFamily="sans-serif-medium"
        android:elevation="2dp"/>
</LinearLayout>
