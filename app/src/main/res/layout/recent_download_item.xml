<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="105dp"
    android:layout_height="170dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:cardMaxElevation="10dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1.2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/thumbicon"
            android:scaleType="centerCrop"
            android:background="#F0F0F0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/item_overlay_gradient" />

        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="@string/videoicon"
            android:padding="8dp"
            android:elevation="4dp"
            android:src="@drawable/ic_play"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:alpha="0.3"
            android:background="@drawable/top_shine_gradient" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>