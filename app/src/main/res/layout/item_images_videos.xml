<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Status/Image thumbnail -->
        <ImageView
            android:id="@+id/imageThumb"
            android:layout_width="100dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_bg"
            android:contentDescription="@string/app_name"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Countdown overlay -->
        <TextView
            android:id="@+id/countdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24:00:00"
            android:background="@drawable/timer_bg"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:layout_margin="6dp"
            app:layout_constraintTop_toTopOf="@id/imageThumb"
            app:layout_constraintStart_toStartOf="@id/imageThumb"/>

        <!-- Download icon -->
        <ImageView
            android:id="@+id/downloadIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:padding="6dp"
            android:background="@drawable/icon_bg"
            android:src="@drawable/ic_download"
            app:layout_constraintBottom_toBottomOf="@id/imageThumb"
            app:layout_constraintEnd_toEndOf="@id/imageThumb"/>

        <!-- WhatsApp double tick icon -->
        <ImageView
            android:id="@+id/downloadStatus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/imgbg_icon"
            android:src="@drawable/ic_double_tick"
            android:visibility="gone"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="@id/imageThumb"
            app:layout_constraintEnd_toEndOf="@id/imageThumb"/>

        <!-- Video icon overlay (centered) -->
        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/imageThumb"
        app:layout_constraintBottom_toBottomOf="@id/imageThumb"
        app:layout_constraintStart_toStartOf="@id/imageThumb"
        app:layout_constraintEnd_toEndOf="@id/imageThumb"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
