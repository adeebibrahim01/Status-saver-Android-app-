<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Ultimate Troubleshooting Guide"
        android:textColor="#333333"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Step 1: Android 11, 12, 13, 14 Users"
                android:textColor="#2FB19C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Navigate to:\nAndroid > media > com.whatsapp > WhatsApp > Media > .Statuses"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Step 2: Android 10 "
                android:textColor="#2FB19C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="If you don't see 'Android/media', look directly for:\nWhatsApp > Media > .Statuses"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Step 3: WhatsApp Business"
                android:textColor="#2FB19C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Look for:\nAndroid > media > com.whatsapp.w4b > WhatsApp Business > Media > .Statuses"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Step 4: Folder is Missing or Hidden?"
                android:textColor="#E91E63"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Click the (⋮) menu in the top right and tap 'Show Hidden Files'. Without this, you cannot see the '.Statuses' folder."
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Step 5: Folder is Empty?"
                android:textColor="#FF9800"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="First, open WhatsApp and watch some statuses. If you haven't viewed any status in the last 24 hours, the folder will appear empty."
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Step 6: Dual Apps / Parallel Space"
                android:textColor="#2FB19C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Search for a folder named 'Dual' or '999' or 'Parallel' in your main storage root."
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#F0F9F8"
                android:padding="12dp"
                android:text="Important: After selecting the folder, tap 'USE THIS FOLDER' and then 'ALLOW'."
                android:textColor="#075E54"
                android:textStyle="bold"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Everything is Clear!"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-bold"
        app:backgroundTint="#2FB19C"
        app:cornerRadius="16dp" />

</LinearLayout>