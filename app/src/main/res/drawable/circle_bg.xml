<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 3D effect using gradient -->
    <gradient
        android:startColor="#075E54"
    android:centerColor="#128C6B"
    android:endColor="#075E54"
    android:angle="270"/>

    <!-- Optional stroke to give depth -->
    <stroke
        android:width="1dp"
        android:color="#033E3B"/>

    <!-- Size of the circle -->
    <size
        android:width="32dp"
        android:height="32dp"/>
</shape>
