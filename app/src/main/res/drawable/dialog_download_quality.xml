<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded_for_imageandvideo">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_all_saved_vault"
        android:contentDescription="Icon"
        android:tint="#075E54" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Download Quality"
        android:textColor="#212121"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Ultra HD uses AI to enhance clarity and colors of your status."
        android:textColor="#757575"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUltraHD"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Ultra HD ✨"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#075E54"
        style="@style/Widget.MaterialComponents.Button"
        android:insetBottom="0dp"
        android:insetTop="0dp"
        app:cornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStandard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Standard Quality"
        android:textAllCaps="false"
        android:textColor="#075E54"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:cornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>