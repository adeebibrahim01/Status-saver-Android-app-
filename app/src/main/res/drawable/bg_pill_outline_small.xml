<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A000000"> <!-- Click karne par halka grey effect -->

    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <!-- Background ko transparent rakha hai taake main background nazar aaye -->
            <solid android:color="@android:color/transparent" />

            <!-- Stroke (Border) ko bohat patla aur subtle rakha hai -->
            <stroke
                android:width="1dp"
                android:color="#D4AF37" /> <!-- Light premium grey border -->

            <!-- Pill shape ke liye radius hamesha layout ki height se zyada rakhein -->
            <corners android:radius="40dp" />
        </shape>
    </item>

</ripple>