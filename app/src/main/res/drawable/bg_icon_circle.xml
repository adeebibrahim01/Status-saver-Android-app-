<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Semi-transparent white background -->
    <solid android:color="#33FFFFFF"/>
    <!-- 33 = ~20% opacity -->

    <!-- Soft subtle border -->
    <stroke
        android:width="1dp"
        android:color="#55FFFFFF"/>
    <!-- 55 = ~33% opacity -->

    <!-- Inner padding -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp"/>

</shape>
