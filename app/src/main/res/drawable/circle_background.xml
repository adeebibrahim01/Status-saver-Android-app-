<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- White circle -->
    <solid android:color="#FFFFFF"/>

    <!-- Optional subtle stroke for depth -->
    <stroke
        android:width="2dp"
        android:color="#DDDDDD"/>

    <!-- Optional shadow/elevation simulation (for Lollipop+, real shadow comes from elevation) -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"/>
</shape>
