<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background: Deep Dark Grey/Black -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Border: Premium Metallic Gold -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#D4AF37" />
        </shape>
    </item>

    <!-- Center Icon: Premium Subtle Logo or Media Icon -->
    <item
        android:gravity="center"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">

        <!-- Yahan aap apna logo ya default icon use kar sakte hain -->
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="#4DFFFFFF"
                android:pathData="M19,5v14H5V5H19M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM14.14,11.86l-3,3.87L9,13.14L6,17h12L14.14,11.86z" />
        </vector>
    </item>

    <!-- Subtle Luxury Overlay (Gradient) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="45"
                android:endColor="#00000000"
                android:startColor="#1A000000"
                android:type="linear" />
        </shape>
    </item>

</layer-list>