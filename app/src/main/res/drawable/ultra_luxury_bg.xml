<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDFDFD" />
        </shape>
    </item>

    <item android:top="-150dp" android:left="-150dp">
        <shape android:shape="oval">
            <size android:width="600dp" android:height="600dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#10D4AF37"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>






    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00FFFFFF"
                android:centerColor="#33D4AF37"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>