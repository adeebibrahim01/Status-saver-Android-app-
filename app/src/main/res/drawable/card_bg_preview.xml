<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dark WhatsApp green color -->
    <solid android:color="#054C44"/> <!-- WhatsApp dark green -->

    <!-- Rounded corners -->
    <corners android:radius="16dp"/>

    <!-- Optional subtle border -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF"/>

    <!-- Inner padding for icons/text -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
