<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"

    app:cardElevation="1.5dp"

    app:cardPreventCornerOverlap="true"

    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#D4AF37"
    app:strokeWidth="1.2dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintDimensionRatio="1:1"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"

        android:background="@android:color/transparent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/premium_thumb_overlay" />

        <ImageView
            android:id="@+id/videoIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:alpha="0.9"
            android:src="@drawable/ic_wa_videos"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#D4AF37" />

        <ImageView
            android:id="@+id/deleteIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_delete_premium"
            android:src="@drawable/ic_delete"
            android:clickable="true"
            android:focusable="true"

        android:elevation="0dp"

        app:tint="#E53935"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/deleteOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/deleteProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                app:indicatorSize="40dp"
                app:indicatorColor="#FFD700"
                app:trackColor="#4DFFFFFF"
                app:trackThickness="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintBottom_toBottomOf="@+id/deleteProgress"
                app:layout_constraintEnd_toEndOf="@+id/deleteProgress"
                app:layout_constraintStart_toStartOf="@+id/deleteProgress"
                app:layout_constraintTop_toTopOf="@+id/deleteProgress" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>